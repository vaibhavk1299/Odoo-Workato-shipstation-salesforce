# Copy to environment.local.env (git-ignored) and fill in for one environment.
# Values only: no passwords, API keys or tokens belong in this file. Credentials are entered directly in
# Workato connections and ShipStation, never stored here.

# Salesforce
SF_ORG_ALIAS=                 # sf CLI alias of the target org, e.g. nfinity-uat
SF_INSTANCE_URL=              # https://<domain>.my.salesforce.com
SF_INTEGRATION_USERNAME=      # user the Workato Salesforce connection signs in as

# Odoo
ODOO_HOST=                    # https://<database>.odoo.com
ODOO_CLOSE_DELIVERY_HOOK_PATH=  # /web/hook/<uuid> of "NFY: ShipStation shipped - close Odoo delivery"

# Workato
WORKATO_HOST=https://app.trial.workato.com
WORKATO_WEBHOOK_BASE=         # https://webhooks.trial.workato.com/webhooks/rest/<workspace id>
WORKATO_PROJECT=NFinity Commerce

# ShipStation
SHIPSTATION_API_BASE=https://ssapi.shipstation.com
SHIPSTATION_SHIP_NOTIFY_URL=  # ${WORKATO_WEBHOOK_BASE}/shipstation_notify
